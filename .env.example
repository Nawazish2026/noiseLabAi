# Server Configuration
PORT=3000
NODE_ENV=development

# MongoDB Connection (MongoDB Atlas or Local mongod instance)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mey7ass.mongodb.net/lab_report_db?retryWrites=true&w=majority
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.mey7ass.mongodb.net/lab_report_db?retryWrites=true&w=majority
# Or local instance: mongodb://127.0.0.1:27017/lab_report_db

# LLM Providers (Provide either Gemini or OpenAI, or leave blank to use the high-fidelity deterministic offline engine)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# LLM Selection Strategy: "auto" | "gemini" | "openai" | "mock"
LLM_PROVIDER=auto

# Safety & System Defaults
DEFAULT_PATIENT_ID=patient_001
MAX_UPLOAD_SIZE_MB=15
